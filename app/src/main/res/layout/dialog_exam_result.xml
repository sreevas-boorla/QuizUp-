<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Success / Completion Icon -->
    <ImageView
        android:id="@+id/iv_result_status_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/ic_launcher_background"
        android:backgroundTint="#E8F5E9"
        android:contentDescription="Result"
        android:padding="14dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/primaryGreen" />

    <TextView
        android:id="@+id/tv_result_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Exam Completed!"
        android:textColor="@color/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_result_quiz_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Java Basics Exam"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp" />

    <!-- Score Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#F9FBF9"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Total Score"
            android:textColor="@color/textColorSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_result_score_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="4 / 5"
            android:textColor="@color/primaryGreenDark"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_result_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="80% • PASSED"
            android:textColor="@color/primaryGreen"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_result_summary_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Your marks have been successfully recorded in your progress history."
        android:textAlignment="center"
        android:textColor="@color/textColorSecondary"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_result_view_history"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/primaryGreen"
        android:text="VIEW PROGRESS HISTORY"
        android:textColor="@color/white"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_result_return_home"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:text="RETURN TO HOME"
        android:textColor="@color/textColorSecondary" />

</LinearLayout>
